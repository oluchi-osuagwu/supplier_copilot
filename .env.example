# Copy this file to .env and fill in real values. .env is gitignored; this template is committed
# so anyone cloning the repo knows which secrets/settings the app expects.

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# SEC EDGAR requires every automated request to identify itself with a name + contact email.
# Requests without it get blocked. Used by the SEC downloader (week 1, step 5).
SEC_USER_AGENT="Your Name your.email@example.com"

# LLM / embeddings provider key (needed from week 2 onward)
OPENAI_API_KEY=
